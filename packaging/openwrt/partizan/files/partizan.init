#!/bin/sh /etc/rc.common
# partizan client under procd. Starts before podkop (whose START is higher), so the SOCKS
# outbound is up when podkop comes up.

USE_PROCD=1
START=90
STOP=10

PROG=/usr/bin/partizan
RUN_DIR=${PARTIZAN_RUN_DIR:-/var/run}

start_service() {
	local enabled uri socks_listen log_level honest_connect

	config_load partizan
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get uri main uri
	if [ -z "$uri" ]; then
		echo "partizan: option uri is empty in /etc/config/partizan" >&2
		return 1
	fi
	config_get socks_listen main socks_listen '127.0.0.1:1080'
	config_get log_level main log_level 'info'
	config_get_bool honest_connect main honest_connect 0

	# The URI holds the token: pass it in a root-only file on tmpfs, never on the command line
	# where `ps` shows it.
	(umask 077 && printf '%s\n' "$uri" > "$RUN_DIR/partizan.uri")

	procd_open_instance
	procd_set_param command "$PROG" run --uri-file "$RUN_DIR/partizan.uri" \
		--socks "$socks_listen" --log-level "$log_level" --admin-sock "$RUN_DIR/partizan.sock"
	[ "$honest_connect" -eq 1 ] && procd_append_param command --honest-connect
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$RUN_DIR/partizan.uri"
}

service_triggers() {
	procd_add_reload_trigger partizan
}
