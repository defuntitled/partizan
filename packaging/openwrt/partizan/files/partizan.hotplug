#!/bin/sh
# WAN came up with a possibly new address: move the QUIC socket so connection migration keeps
# the session (and calls) alive instead of waiting for a timeout.
[ "$ACTION" = ifup ] || exit 0
[ "$INTERFACE" = wan ] || [ "$INTERFACE" = wan6 ] || exit 0
[ -S /var/run/partizan.sock ] || exit 0
/usr/bin/partizan rebind --admin-sock /var/run/partizan.sock >/dev/null 2>&1 || true
