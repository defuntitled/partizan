[Unit]
Description=partizan VPN server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/partizan-server run --config /etc/partizan/server.toml
ExecReload=/bin/kill -HUP $MAINPID
User=partizan
Group=partizan
# Port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# /run/partizan holds the admin socket.
RuntimeDirectory=partizan
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
LimitNOFILE=65536
# SIGTERM: GoAway to clients, then up to 30 s for open streams.
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
